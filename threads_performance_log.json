      "basis": "per_1k"
    },
    {
      "at": "2026-08-14T17:07:01.622Z",
      "pillar": "systems",
      "kind": "value_cta",
      "isThread": false,
      "parts": 1,
      "text": "The one-metric week:\n\nPick the single metric your constraint lives in. Move only that for 7 days. Ignore the rest.\n\nMore of these on @markusreidgt.",
      "accounts": [
        "markusreidgt"
      ],
      "permalink": "https://www.threads.com/@markusreidgt/post/DcBz9pBoLnm",
      "metrics": {
        "views": 7,
        "likes": 0,
        "replies": 0,
        "reposts": 0,
        "quotes": 0,
        "shares": 0
      },
      "views": 7,
      "engagement": 0,
      "per_1k": 0,
      "basis": "per_1k"
    },
    {
      "at": "2026-08-14T15:04:35.446Z",
      "pillar": "systems",
      "kind": "loop",
      "isThread": false,
      "parts": 1,
      "text": "The whole operating system, three steps:\n\n1. Name the constraint.\n2. Move only that number.\n3. Verify it moved.\n\nStep three is the one everyone skips, which is why the same fix gets \"tried\" four times a year and nobody can say whether it wo",
      "accounts": [
