    },
    {
      "at": "2026-08-14T20:41:49.840Z",
      "pillar": "decision",
      "kind": "price_it",
      "isThread": false,
      "parts": 1,
      "text": "Put a number on the gap or nothing happens.\n\n\"We should improve follow-up\" is a shrug in a meeting.\n\n\"Follow-up costs us about $18k a month\" is a decision with a deadline.\n\nSame fact. Only one of them gets scheduled.",
      "accounts": [
        "markusreidgt"
      ],
      "permalink": "https://www.threads.com/@markusreidgt/post/DcCMi6WGsmZ",
      "metrics": {
        "views": 7,
        "likes": 0,
        "replies": 0,
        "reposts": 0,
        "quotes": 0,
        "shares": 0
      },
      "views": 7,
